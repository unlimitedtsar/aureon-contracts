{
  "$defs": {
    "CanonicalMeta": {
      "additionalProperties": false,
      "description": "Metadata for distributed messages to ensure versioning and compatibility.",
      "properties": {
        "version": {
          "default": "v1",
          "description": "Contract version (e.g., v1, v2)",
          "title": "Version",
          "type": "string"
        },
        "schema_id": {
          "description": "Unique schema identifier for cross-language mapping",
          "title": "Schema Id",
          "type": "string"
        },
        "timestamp": {
          "description": "Unix timestamp for cross-language safety",
          "title": "Timestamp",
          "type": "integer"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Correlation ID for distributed tracing (root trace)",
          "title": "Trace Id"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique identifier for the specific request-response cycle",
          "title": "Request Id"
        }
      },
      "required": [
        "schema_id"
      ],
      "title": "CanonicalMeta",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "description": "Distributed identity model for tracking agents, tenants, and sessions across layers.",
      "properties": {
        "agent_id": {
          "description": "Unique ID of the actor/agent",
          "title": "Agent Id",
          "type": "string"
        },
        "tenant_id": {
          "description": "Multi-tenant isolation identifier",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Logical session grouping",
          "title": "Session Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical request correlation ID",
          "title": "Correlation Id"
        },
        "origin_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The node ID where the message originated",
          "title": "Origin Node"
        }
      },
      "required": [
        "agent_id",
        "tenant_id",
        "session_id"
      ],
      "title": "Identity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Standard Envelope wrapper for all distributed messages.\nEnsures that every data payload is accompanied by versioning, timing, and identity context.",
  "properties": {
    "meta": {
      "allOf": [
        {
          "$ref": "#/$defs/CanonicalMeta"
        }
      ],
      "description": "Versioning and timing metadata"
    },
    "identity": {
      "allOf": [
        {
          "$ref": "#/$defs/Identity"
        }
      ],
      "description": "Logical and physical identity of the sender"
    },
    "data": {
      "description": "The actual payload of the message",
      "title": "Data"
    }
  },
  "required": [
    "meta",
    "identity",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}